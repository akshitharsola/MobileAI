+++ b/android/mlc4j/CMakeLists.txt
@@ -41,10 +41,22 @@ add_custom_command(
   COMMAND ${CMAKE_COMMAND} -E copy ${JNI_HEADER}/org_apache_tvm_LibInfo.h
           ${JNI_HEADER}/org_apache_tvm_native_c_api.h)
 
+# Create an empty placeholder if no pre-compiled model library exists
+set(MODEL_ANDROID_LIB ${ANDROID_BIN_DIR}/lib/libmodel_android.a)
+if(NOT EXISTS ${MODEL_ANDROID_LIB})
+  file(MAKE_DIRECTORY ${ANDROID_BIN_DIR}/lib)
+  execute_process(
+    COMMAND ${CMAKE_AR} rcs ${MODEL_ANDROID_LIB}
+    RESULT_VARIABLE AR_RESULT)
+  if(NOT AR_RESULT EQUAL 0)
+    # Fallback: use llvm-ar from NDK
+    set(LLVM_AR ${ANDROID_TOOLCHAIN_ROOT}/bin/llvm-ar)
+    execute_process(COMMAND ${LLVM_AR} rcs ${MODEL_ANDROID_LIB})
+  endif()
+endif()
